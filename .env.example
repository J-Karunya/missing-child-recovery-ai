# Optional LLM-backed profile parser. Leave unset for the safe all-unknown fallback.
OPENAI_API_KEY=
PROFILE_PARSER_MODEL=gpt-4.1-mini

# Prototype input selection. Values are filenames/IDs, not filesystem paths.
MISSING_CHILD_ID=MC001
CCTV_VIDEO_FILE=station.mp4
CHILD_IMAGE_FILE=child1.jpeg

# Local safety and reporting controls. These are not authentication controls.
POTENTIAL_MATCH_THRESHOLD=60
MIN_TRACK_OBSERVATIONS=3
CCTV_PROGRESS_INTERVAL=30
MAX_CCTV_VIDEO_BYTES=524288000
EVIDENCE_RETENTION_DAYS=30
MAX_CCTV_UPLOAD_BYTES=524288000

# Sprint 5 authentication/session settings. Never commit a real password or key.
SESSION_TIMEOUT_MINUTES=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Optional, only for the explicit development-only demo initializer script.
DEMO_USER_PASSWORD=

# Retention is report-only by default. Review applicable policy before enabling deletion.
CCTV_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365
RETENTION_DRY_RUN=true
