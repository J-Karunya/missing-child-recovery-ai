# EXAMPLE ONLY: provide approved TLS certificates outside this repository.
server {
    listen 443 ssl http2;
    server_name example.invalid;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location / { proxy_pass http://127.0.0.1:8501; proxy_set_header Host $host; proxy_set_header X-Forwarded-Proto https; }
}
